# Server-only. Never use NEXT_PUBLIC_ for database credentials.
# Retrieve real values using: neon env pull
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production
# Same server-only value as the Production variable on Vercel.
CRON_SECRET=

# Dữ Liệu Kinh Tế API. Server-only, also set in Vercel Production/Preview.
DLKT_API_KEY=
